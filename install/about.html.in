<style>
:root { color-scheme: dark; }
body { background: #000; color: #e8e8e8; margin: 0; padding: 40px 20px;
       font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
main { max-width: 34rem; margin: 0 auto; }
img { display: block; width: 240px; max-width: 70%; height: auto; }
.ver { color: #8a8a8a; font-size: .85rem; margin: .6rem 0 2.4rem; }
h1 { font-size: 1.35rem; line-height: 1.35; font-weight: 600; margin: 0 0 1rem; }
h2 { font-size: .8rem; letter-spacing: .09em; text-transform: uppercase;
     color: #8a8a8a; font-weight: 600; margin: 2.6rem 0 .8rem; }
p { margin: 0 0 1rem; }
code { background: #1a1a1a; border: 1px solid #2c2c2c; border-radius: 3px;
       padding: .1em .4em; font-size: .9em; }

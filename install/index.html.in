<meta http-equiv="X-UA-Compatible" content="IE=8">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>Install Project Lyra</title>

<meta name="description" content="A persistent jailbreak and modding platform for the Zune HD, installed from the device's own browser.">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Project Lyra">
<meta property="og:url" content="http://install.zune.moe/">
<meta property="og:title" content="Project Lyra">
<meta property="og:description" content="A persistent jailbreak and modding platform for the Zune HD, installed from the device's own browser.">
<meta property="og:image" content="http://install.zune.moe/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Project Lyra">
<meta name="twitter:card" content="summary_large_image">

<style type="text/css">
body { background: #000; color: #fff; font-family: Verdana, sans-serif;
       margin: 0; padding: 16px; }
#app { width: 100%; max-width: 420px; }
#logo { display: block; border: 0; margin-bottom: 6px; }
#ver { font-size: 12px; color: #9a9a9a; margin: 0 0 10px 0; }
#what { font-size: 13px; color: #cfcfcf; margin: 0 0 18px 0; line-height: 1.45em; }
#go { display: block; width: 100%; height: 56px; font-size: 20px; font-weight: bold;
      color: #000; background: #f0f0f0; border: 2px solid #fff; margin-bottom: 16px; }
#go.off { color: #6a6a6a; background: #2a2a2a; border-color: #4a4a4a; }
#msg { font-size: 14px; line-height: 1.5em; min-height: 6em; }
#msg b { color: #fff; }
#note { font-size: 11px; color: #8a8a8a; margin-top: 20px; line-height: 1.45em; }
#log { font-size: 10px; color: #4ad24a; margin-top: 18px; word-wrap: break-word; }
</style>

<div id="app">
  <!-- No alpha: this engine renders PNG transparency as grey. -->
  <img id="logo" src="lyra.png" width="280" height="85" alt="Project Lyra">
  <div id="ver">__VERSION__ &nbsp;&middot;&nbsp; Zune HD firmware 4.5</div>
  <div id="what">A persistent jailbreak and modding platform for the Zune HD.</div>
  <!-- Ships in the scripting-off state; the script below turns it on. With Script
       off nothing here runs, so this markup is all such a device can say. -->
  <button id="go" class="off" onclick="start()">Install</button>
  <div id="msg">
    <b>Scripting is turned off on this Zune, so this page cannot install anything.</b>
    <br><br>
    On the Zune, go to <b>Settings</b>, then <b>Internet</b>, and set
    <b>Script</b> to <b>Enabled</b>. Then come back here and tap Install.
  </div>
  <div id="note">
    Your music, videos and settings are left alone.
    To remove Lyra later, open the Mods tab and remove Project Lyra.
    <br><br>
    Installing Lyra changes how the device behaves and allows arbitrary third party code
    to run. While Lyra has measures to disable mods which prevent successful booting,
    there is always a chance that the device may be unable to start and require restoring
    to a fresh state, losing your existing data. You do this at your own risk.
  </div>
  <div id="log"></div>
</div>

<script type="text/javascript">
__CHAIN__
</script>

<script type="text/javascript">

/* stub.S. The image follows it as a little-endian count, then that many bytes. */
var STUB = __STUB_BYTES__;

var IMAGE_URL   = "__IMAGE_URL__";
var IMAGE_BYTES = __IMAGE_BYTES__;   /* count + payload + any pad, as transferred */

var DEBUG = (window.location.search + "").indexOf("debug") >= 0;

/* The chain is a race the device loses more often than it wins. */
var MAX_TRIES = 5;

var busy = true;
var blocked = null;      /* why the button is off, or null once the page is usable */
var cached = null;
var tries = 0;
var stages = [];

function el(id) { return document.getElementById(id); }
function say(html) { el("msg").innerHTML = html; }
function trail(s) { el("log").innerHTML = s; }
function dbg(s) { if (DEBUG) { el("log").innerHTML += s + "<br>"; } }

/* Never disabled: a tap must always be able to reprint why nothing is happening. */
function arm(on) {
    el("go").className = on ? "" : "off";
    busy = !on;
}

/* Low byte first, matching how the chain lays bytes into a string. Chunked: one
   fromCharCode.apply over 27 K units exceeds the argument limit. */
var B64_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
var B64_MAP = null;

function b64ToString(text) {
    if (!B64_MAP) {
        B64_MAP = {};
        for (var k = 0; k < B64_ALPHABET.length; k++) {
            B64_MAP["" + B64_ALPHABET.charAt(k)] = k;
        }
    }

    var pieces = [], chunk = [];
    var acc = 0, nbits = 0, carry = -1, nbytes = 0;

    for (var i = 0; i < text.length; i++) {
        var c = text.charAt(i);
        if (c === "=") { break; }
        var v = B64_MAP[c];
        if (v === undefined) { continue; }
        acc = (acc << 6) | v;
        nbits += 6;
        if (nbits < 8) { continue; }
        nbits -= 8;
        var b = (acc >> nbits) & 0xFF;
        nbytes++;
        if (carry < 0) {
            carry = b;
        } else {
            chunk[chunk.length] = carry | (b << 8);
            carry = -1;
            if (chunk.length >= 4096) {
                pieces[pieces.length] = String.fromCharCode.apply(null, chunk);
                chunk = [];
            }
        }
    }
    if (carry >= 0) { chunk[chunk.length] = carry; nbytes++; }
    if (chunk.length > 0) { pieces[pieces.length] = String.fromCharCode.apply(null, chunk); }

    return { text: pieces.join(""), bytes: nbytes };
}

function stubString() {
    var units = [];
    for (var i = 0; i + 1 < STUB.length; i += 2) {
        units[units.length] = STUB[i] | (STUB[i + 1] << 8);
    }
    return String.fromCharCode.apply(null, units);
}

function fail(what) {
    say(what + "<br><br>Tap Install to try again.");
    arm(true);
}

function start() {
    if (blocked) { say(blocked); return; }
    if (busy) { return; }
    arm(false);
    tries = 0;
    stages = [];

    if (cached) { attemptSoon(); return; }

    say("Downloading Project Lyra...");
    window.setTimeout(download, 60);
}

function download() {
    var xhr;
    try {
        xhr = new ActiveXObject("Microsoft.XMLHTTP");
    } catch (e) {
        fail("This browser cannot download the installer. (E-XHR)");
        return;
    }

    xhr.onreadystatechange = function () {
        if (xhr.readyState !== 4) { return; }
        var status = 0;
        try { status = xhr.status; } catch (e) { status = 0; }
        if (status === 0) {
            fail("Could not reach install.zune.moe.<br><br>Check the Zune is on Wi-Fi, "
               + "then tap Install again. (E-NET)");
            return;
        }
        if (status !== 200) {
            fail("The server would not send the installer, it answered " + status
               + ". (E-HTTP " + status + ")");
            return;
        }
        var body = xhr.responseText;
        dbg("got " + body.length + " b64 chars");
        say("Preparing...");
        window.setTimeout(function () { prepare(body); }, 60);
    };

    try {
        xhr.open("GET", IMAGE_URL, true);
        xhr.send();
    } catch (e) {
        fail("Could not reach install.zune.moe.<br><br>Check the Zune is on Wi-Fi, "
           + "then tap Install again. (E-NET)");
    }
}

function prepare(body) {
    var got = b64ToString(body);
    dbg("decoded " + got.bytes + " bytes, want " + IMAGE_BYTES);

    if (got.bytes !== IMAGE_BYTES) {
        fail("The download stopped early, " + got.bytes + " of " + IMAGE_BYTES
           + " bytes arrived.<br><br>Check the Zune's Wi-Fi signal. (E-SHORT)");
        return;
    }

    cached = stubString() + got.text;
    dbg("shellcode " + cached.length + " units");
    attemptSoon();
}

/* run() returns null when the last step landed without the installer taking over,
   which is a loss like any other. */
var STAGE = {
    "leak":   "The browser never leaked its memory layout (stage: leak).",
    "locate": "The installer could not be found in memory (stage: locate).",
    "fire":   "The last step did not land (stage: fire).",
    "hijack": "The last step landed but the installer did not start (stage: hijack).",
    "error":  "The installer script hit an error (stage: error)."
};

/* Paint first: LyraChain.run blocks this thread, and nothing repaints until it returns. */
function attemptSoon() {
    tries++;
    say("Installing, attempt " + tries + " of " + MAX_TRIES + ".<br><br>"
      + "Keep the Zune awake and do not turn it off. The screen stops responding "
      + "while each attempt runs.");
    window.setTimeout(attempt, 120);
}

function attempt() {
    var stage;
    try {
        stage = LyraChain.run(cached, dbg);
        if (stage === null) { stage = "hijack"; }
    } catch (e) {
        stage = "error";
        dbg("threw: " + e.message);
    }
    /* Reached only on a loss: a win exits this thread inside run(). */
    stages[stages.length] = stage;
    trail("stages: " + stages.join(", "));

    if (tries < MAX_TRIES) { window.setTimeout(attemptSoon, 400); return; }

    fail("Lyra did not install after " + MAX_TRIES + " attempts.<br><br>"
       + (STAGE[stage] || ("Stage: " + stage)) + "<br><br>"
       + "This is normal and harmless. The last step is a race the Zune often "
       + "loses, and nothing on the device was changed.");
}

function envProblem() {
    if (typeof LyraChain === "undefined") {
        return "The installer script did not load. Reload this page. (E-CHAIN)";
    }
    /* No code: the reader here is a desktop visitor, not someone reporting a device. */
    if (typeof CollectGarbage !== "function") {
        return "This is not the Zune HD browser, so there is nothing here to run.<br><br>"
             + "Put the Zune HD on Wi-Fi, open its browser, and go to "
             + "<b>install.zune.moe</b>.";
    }
    try {
        if (!new ActiveXObject("Microsoft.XMLHTTP")) { throw 0; }
    } catch (e) {
        return "This browser cannot download the installer. (E-XHR)";
    }
    return null;
}

blocked = envProblem();
if (blocked) {
    say(blocked);
} else {
    say("Tap Install. Keep the Zune awake and on Wi-Fi until it restarts by itself.");
    arm(true);
}

</script>
